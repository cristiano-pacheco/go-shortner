      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(shortener_http_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP latency",
      "description": "Request duration percentiles by method and normalized route. An idle route may have no data.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
