# Docker Compose: choose local-only credentials before starting.
# Copy this file to .env. Start only PostgreSQL and Redis with:
# docker compose --env-file .env -f docker/docker-compose.yaml up -d
# To include the application, use both files and run migrations explicitly:
# docker compose --env-file .env -f docker/docker-compose.yaml -f docker/docker-compose.app.yaml build app
# docker compose --env-file .env -f docker/docker-compose.yaml -f docker/docker-compose.app.yaml run --rm app migrate
# docker compose --env-file .env -f docker/docker-compose.yaml -f docker/docker-compose.app.yaml up -d app public
# To remove the database as well:
# docker compose --env-file .env -f docker/docker-compose.yaml -f docker/docker-compose.app.yaml down -v
# APP_PORT is management; PUBLIC_PORT is redirects. Match PUBLIC_BASE_URL to PUBLIC_PORT.
POSTGRES_DB=shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=
API_KEY=
APP_PORT=8080
PUBLIC_PORT=8081
METRICS_PORT=9090
PUBLIC_METRICS_PORT=9093
POSTGRES_PORT=5432
REDIS_PORT=6379
PUBLIC_BASE_URL=http://localhost:8081

# Settings for running the application directly on the host.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=shortener
DATABASE_USER=shortener
DATABASE_PASSWORD=
# Bricks accepts true (TLS required) or false (TLS disabled).
DATABASE_SSLMODE=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
HTTP_ADDR=127.0.0.1:8080
